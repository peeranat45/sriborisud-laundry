<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="D_W2_ToBe" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://sriborisud.local/bpmn" exporter="sriborisud-laundry IS" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_Main" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="P_W2_ToBe"/>
  </bpmn:collaboration>
  <bpmn:process id="P_W2_ToBe" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="L_Asst" name="ผู้ช่วย">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Wash" name="คนซัก">
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="ระบบสารสนเทศ">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="เริ่มรอบซักประจำวัน">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_ed"/>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="ดูคิวผ้ารอซัก เรียงตามวันครบกำหนด">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T2" name="สแกนผ้าที่หยิบจากตู้">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S1" name="บันทึก status_event = WASHING">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T3" name="ซักตามที่ได้รับมอบหมาย">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T4" name="สแกนผ้าเมื่อนำขึ้นราวตาก">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S2" name="บันทึก DRYING และนับจำนวนเข้าค่าแรง">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E" name="ผ้าอยู่บนราวตาก นับค่าแรงแล้ว">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>คิวเรียงตามวันครบกำหนด ไม่ใช่ตามที่อยู่ใกล้มือ  [แก้ PP __]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>การสแกนคือการนับ ไม่ต้องจดกระดาษอีก  [แก้ PP 8 · PP 9]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>งานใหม่ที่เพิ่มขึ้น พนักงานต้องสแกน 2 ครั้งต่อชิ้นในขั้นนี้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="S1"/>
    <bpmn:sequenceFlow id="F4" sourceRef="S1" targetRef="T3"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T4" targetRef="S2"/>
    <bpmn:sequenceFlow id="F7" sourceRef="S2" targetRef="E"/>
    <bpmn:association id="A1_a" sourceRef="T1" targetRef="A1"/>
    <bpmn:association id="A2_a" sourceRef="S2" targetRef="A2"/>
    <bpmn:association id="A3_a" sourceRef="T2" targetRef="A3"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="D_1">
    <bpmndi:BPMNPlane id="PL_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="P_Main_di" bpmnElement="P_Main" isHorizontal="true">
