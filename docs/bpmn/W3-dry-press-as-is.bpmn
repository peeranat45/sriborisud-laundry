<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="D_W3_AsIs" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://sriborisud.local/bpmn" exporter="sriborisud-laundry IS" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_Main" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="P_W3_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="P_W3_AsIs" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="L_Asst" name="ผู้ช่วย">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Iron" name="ช่างรีด">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="ผ้าอยู่บนราวตาก">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="T1" name="เดินไปจับดูว่าแห้งหรือยัง">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G1" name="แห้งหรือยัง">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T2" name="เก็บผ้าจากราว">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T3" name="คัดแยกและส่งให้ช่างรีด">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T4" name="รีดและจัดแต่งทรง">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T5" name="ตรวจความสะอาดขณะรีด">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G2" name="สะอาดหรือไม่">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="E2" name="ส่งกลับไปซักใหม่">
      <bpmn:incoming>F9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="T6" name="นำเข้าตู้ผ้าเสร็จ">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="E1" name="ผ้าอยู่ในตู้รอรับ">
      <bpmn:incoming>F11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>ต้องเดินไปดูเอง ไม่มีใครรู้ว่าผ้าแห้งเมื่อไร เสียเวลาเดินซ้ำหลายรอบ  [PP __]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>ลำดับการรีดขึ้นกับว่าอะไรอยู่ใกล้มือ งานด่วนต้องตามด้วยวาจา  [PP __]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>ตู้เรียงตามเลขบิล หาด้วยสายตาเท่านั้น  [PP 14]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="G1"/>
    <bpmn:sequenceFlow id="F3" name="ยังไม่แห้ง" sourceRef="G1" targetRef="T1"/>
    <bpmn:sequenceFlow id="F4" name="แห้งแล้ว" sourceRef="G1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="T5"/>
    <bpmn:sequenceFlow id="F8" sourceRef="T5" targetRef="G2"/>
    <bpmn:sequenceFlow id="F9" name="ไม่สะอาด" sourceRef="G2" targetRef="E2"/>
    <bpmn:sequenceFlow id="F10" name="สะอาด" sourceRef="G2" targetRef="T6"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="E1"/>
    <bpmn:association id="A1_a" sourceRef="T1" targetRef="A1"/>
    <bpmn:association id="A2_a" sourceRef="T4" targetRef="A2"/>
    <bpmn:association id="A3_a" sourceRef="T6" targetRef="A3"/>
  </bpmn:process>
