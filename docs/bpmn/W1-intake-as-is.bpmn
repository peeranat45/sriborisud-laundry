        <di:waypoint x="1488" y="500"/>
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="DOA_3_di" bpmnElement="DOA_3">
        <di:waypoint x="2063" y="410"/>
        <di:waypoint x="2063" y="500"/>
