      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_Verbal_di" bpmnElement="T_Verbal">
        <dc:Bounds x="1710" y="230" width="140" height="80"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="G_RushJ_di" bpmnElement="G_RushJ">
        <dc:Bounds x="1900" y="345" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="T_WriteNo_di" bpmnElement="T_WriteNo">
