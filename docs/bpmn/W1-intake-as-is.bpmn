      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_1_di" bpmnElement="End_1">
        <dc:Bounds x="2380" y="352" width="36" height="36"/>
        <bpmndi:BPMNLabel><dc:Bounds x="2320" y="394" width="156" height="30"/></bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DS_BillBook_di" bpmnElement="DS_BillBook">
        <dc:Bounds x="700" y="500" width="50" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_Receipt_di" bpmnElement="DO_Receipt">
        <dc:Bounds x="1470" y="500" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="DO_PaperTag_di" bpmnElement="DO_PaperTag">
        <dc:Bounds x="2045" y="500" width="36" height="50"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A1_di" bpmnElement="A1">
        <dc:Bounds x="640" y="640" width="240" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A2_di" bpmnElement="A2">
        <dc:Bounds x="1000" y="640" width="250" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A3_di" bpmnElement="A3">
        <dc:Bounds x="1660" y="100" width="250" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="A4_di" bpmnElement="A4">
        <dc:Bounds x="1980" y="640" width="260" height="60"/>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="F1_di" bpmnElement="F1">
