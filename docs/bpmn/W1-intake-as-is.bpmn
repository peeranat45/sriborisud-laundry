<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Defs_W1_AsIs" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
         xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
         xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
         xmlns:di="http://www.omg.org/spec/DD/20100524/DI"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         targetNamespace="http://sriborisud.local/bpmn"
         exporter="sriborisud-laundry IS" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="Participant_Customer" name="ลูกค้า"/>
    <bpmn:participant id="Participant_Shop" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="Process_Shop_AsIs"/>
    <bpmn:messageFlow id="MF_Clothes" name="ส่งมอบเสื้อผ้า" sourceRef="Participant_Customer" targetRef="Start_1"/>
    <bpmn:messageFlow id="MF_Receipt" name="ใบรับของ" sourceRef="T_Bill" targetRef="Participant_Customer"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_Shop_AsIs" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Owner" name="เจ้าของร้าน">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_WritePhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PhoneJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Rush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Verbal</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RushJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_WriteNo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cabinet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="ลูกค้านำเสื้อผ้ามาส่ง">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_1_med"/>
    </bpmn:startEvent>
    <bpmn:manualTask id="T_Inspect" name="ตรวจนับและแยกชนิดเสื้อผ้า">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Due" name="ประเมินวันแล้วเสร็จ">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DIA_1"><bpmn:sourceRef>DS_BillBook</bpmn:sourceRef></bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Price" name="คำนวณราคา">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Cust" name="รับข้อมูลลูกค้า">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G_Phone" name="ลูกค้าให้เบอร์โทรหรือไม่">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_WritePhone" name="จดเบอร์โทรลงในบิล">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G_PhoneJ">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Bill" name="ออกบิล Running Number และใบรับของ">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_1"><bpmn:targetRef>DS_BillBook</bpmn:targetRef></bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DOA_2"><bpmn:targetRef>DO_Receipt</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G_Rush" name="งานด่วนหรือไม่">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_Verbal" name="แจ้งช่างรีดด้วยวาจา">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="G_RushJ">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_WriteNo" name="เขียนเลขบิลบนเสื้อผ้าทุกชิ้น">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_3"><bpmn:targetRef>DO_PaperTag</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_Cabinet" name="นำเสื้อผ้าเข้าตู้รอซัก">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_1" name="เสื้อผ้าอยู่ในตู้รอซัก">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_BillBook" name="เล่มบิล (กระดาษ)"/>
    <bpmn:dataObject id="DO_Receipt_do"/>
    <bpmn:dataObjectReference id="DO_Receipt" name="ใบรับของ" dataObjectRef="DO_Receipt_do"/>
    <bpmn:dataObject id="DO_PaperTag_do"/>
    <bpmn:dataObjectReference id="DO_PaperTag" name="เลขบิลบนป้ายกระดาษ" dataObjectRef="DO_PaperTag_do"/>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>ไม่มีตารางราคาเป็นลายลักษณ์อักษร ราคาขึ้นกับประสบการณ์ของคนออกบิล</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>ประมาณ 20% ของบิลไม่มีช่องทางติดต่อ ≈ 4,000 บิลต่อปี</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>แจ้งด้วยวาจา ไม่เหลือร่องรอย 4–5 ครั้งต่อสัปดาห์</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A4">
      <bpmn:text>ตัวตนของผ้าหนึ่งชิ้นคือหมึกบนกระดาษ หลุดแล้วตามไม่ได้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="T_Inspect"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_Inspect" targetRef="T_Due"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T_Due" targetRef="T_Price"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T_Price" targetRef="T_Cust"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T_Cust" targetRef="G_Phone"/>
    <bpmn:sequenceFlow id="F6" name="ให้เบอร์" sourceRef="G_Phone" targetRef="T_WritePhone"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T_WritePhone" targetRef="G_PhoneJ"/>
    <bpmn:sequenceFlow id="F8" name="ไม่ให้เบอร์" sourceRef="G_Phone" targetRef="G_PhoneJ"/>
    <bpmn:sequenceFlow id="F9" sourceRef="G_PhoneJ" targetRef="T_Bill"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T_Bill" targetRef="G_Rush"/>
    <bpmn:sequenceFlow id="F11" name="ด่วน" sourceRef="G_Rush" targetRef="T_Verbal"/>
    <bpmn:sequenceFlow id="F12" sourceRef="T_Verbal" targetRef="G_RushJ"/>
    <bpmn:sequenceFlow id="F13" name="ปกติ" sourceRef="G_Rush" targetRef="G_RushJ"/>
    <bpmn:sequenceFlow id="F14" sourceRef="G_RushJ" targetRef="T_WriteNo"/>
    <bpmn:sequenceFlow id="F15" sourceRef="T_WriteNo" targetRef="T_Cabinet"/>
    <bpmn:sequenceFlow id="F16" sourceRef="T_Cabinet" targetRef="End_1"/>
    <bpmn:association id="A1_as" sourceRef="T_Price" targetRef="A1"/>
    <bpmn:association id="A2_as" sourceRef="G_Phone" targetRef="A2"/>
    <bpmn:association id="A3_as" sourceRef="T_Verbal" targetRef="A3"/>
    <bpmn:association id="A4_as" sourceRef="T_WriteNo" targetRef="A4"/>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_1">
    <bpmndi:BPMNPlane id="Plane_1" bpmnElement="Collab_1">
      <bpmndi:BPMNShape id="Participant_Customer_di" bpmnElement="Participant_Customer" isHorizontal="true">
        <dc:Bounds x="160" y="80" width="2320" height="70"/>
