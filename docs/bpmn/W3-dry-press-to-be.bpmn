<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="D_W3_ToBe" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://sriborisud.local/bpmn" exporter="sriborisud-laundry IS" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_Cust" name="ลูกค้า"/>
    <bpmn:participant id="P_Main" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="P_W3_ToBe"/>
    <bpmn:messageFlow id="MF1" name="แจ้งว่าผ้าพร้อมรับ" sourceRef="S3" targetRef="P_Cust"/>
  </bpmn:collaboration>
  <bpmn:process id="P_W3_ToBe" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="L_Asst" name="ผู้ช่วย">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Iron" name="ช่างรีด">
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="ระบบสารสนเทศ">
        <bpmn:flowNodeRef>S1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="ผ้าอยู่บนราวตาก">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="T1" name="ตรวจว่าแห้งแล้วและสแกน">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S1" name="บันทึก PRESSING และเข้าคิวช่างรีด">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T2" name="ดูคิวงานเรียงตามวันครบกำหนด">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T3" name="รีดและตรวจคุณภาพ">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G1" name="พบปัญหาหรือไม่">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="T4" name="สแกนและแจ้งปัญหา">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S2" name="แจ้งเจ้าของร้านทันที">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E2" name="รอเจ้าของร้านตัดสินใจ">
      <bpmn:incoming>F8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:userTask id="T5" name="สแกนว่ารีดเสร็จ">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T6" name="นำเข้าตู้ผ้าเสร็จ">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S3" name="บันทึก READY และส่งแจ้งเตือน LINE">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="E1" name="ลูกค้ารู้แล้วว่าผ้าเสร็จ">
      <bpmn:incoming>F12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>ความเร่งด่วนอยู่ในคิว ไม่ต้องอยู่ในหัวเจ้าของร้าน  [แก้ PP __]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>ชิ้นสุดท้ายเข้า READY แล้วระบบแจ้ง LINE เอง · W5 รอบโทรตอนเย็นหายไป  [แก้ PP 22–24]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="S1"/>
    <bpmn:sequenceFlow id="F3" sourceRef="S1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T3" targetRef="G1"/>
    <bpmn:sequenceFlow id="F6" name="พบปัญหา" sourceRef="G1" targetRef="T4"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T4" targetRef="S2"/>
    <bpmn:sequenceFlow id="F8" sourceRef="S2" targetRef="E2"/>
    <bpmn:sequenceFlow id="F9" name="ไม่พบ" sourceRef="G1" targetRef="T5"/>
    <bpmn:sequenceFlow id="F10" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="F11" sourceRef="T6" targetRef="S3"/>
    <bpmn:sequenceFlow id="F12" sourceRef="S3" targetRef="E1"/>
    <bpmn:association id="A1_a" sourceRef="T2" targetRef="A1"/>
    <bpmn:association id="A2_a" sourceRef="S3" targetRef="A2"/>
  </bpmn:process>
