  <diagram name="BPMN To-Be" id="tb-page-1">
    <mxGraphModel grid="0" page="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" pageScale="1" pageWidth="850" pageHeight="1100" background="light-dark(#FFFFFF,#FFFFFF)" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="tb-h-1" value="&lt;font style=&quot;font-size: 20px;&quot; face=&quot;Tahoma&quot;&gt;&lt;b&gt;BPMN To-Be ทั้งระบบ&lt;/b&gt; · W1–W6 หลังนำ IT มาใช้ + กระบวนการใหม่ W0 และ W7&lt;br&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;รูปคน = คนทำผ่านระบบ · รูปมือ = คนทำด้วยมือ · รูปเฟือง = ระบบทำเอง · เส้นประ = ข้อความระหว่างร้านกับภายนอก · กล่องสีชมพูใต้แต่ละรูป = สิ่งที่เปลี่ยนและสิ่งที่ยังไม่ยืนยัน&lt;/font&gt;&lt;/font&gt;" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=top;rounded=0;fontFamily=Architects Daughter;fontSource=https%3A%2F%2Ffonts.googleapis.com%2Fcss%3Ffamily%3DArchitects%2BDaughter;" vertex="1" parent="1"><mxGeometry x="190" y="-110" width="1500" height="70" as="geometry"/></mxCell>
