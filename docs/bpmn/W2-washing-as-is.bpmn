<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="D_W2_AsIs" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://sriborisud.local/bpmn" exporter="sriborisud-laundry IS" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_Main" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="P_W2_AsIs"/>
  </bpmn:collaboration>
  <bpmn:process id="P_W2_AsIs" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="L_Asst" name="ผู้ช่วย">
        <bpmn:flowNodeRef>S</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Wash" name="คนซัก">
        <bpmn:flowNodeRef>T4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>E</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="S" name="เริ่มรอบซักประจำวัน">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:timerEventDefinition id="S_ed"/>
    </bpmn:startEvent>
    <bpmn:manualTask id="T1" name="เลือกงานที่จะซักวันนี้">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T2" name="หยิบเสื้อผ้าจากตู้รอซัก">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T3" name="แยกตามประเภทการซัก">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T4" name="ซักตามที่ได้รับมอบหมาย">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T5" name="นำผ้าเปียกขึ้นราวตาก">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T6" name="จดจำนวนผ้าที่ซักลงกระดาษ">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA1"><bpmn:targetRef>DO1</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:endEvent id="E" name="ผ้าอยู่บนราวตาก">
      <bpmn:incoming>F7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataObject id="DO1_d"/>
    <bpmn:dataObjectReference id="DO1" name="กระดาษจดจำนวน" dataObjectRef="DO1_d"/>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>เลือกงานด้วยสายตา ไม่มีลำดับตามวันครบกำหนด ผ้าที่อยู่ลึกในตู้ค้างได้หลายวัน  [PP __]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>ไม่มีบันทึกว่าผ้าชิ้นไหนถูกซักเมื่อไร ใครซัก  [PP __]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>จำนวนที่จดคือฐานของค่าแรง แต่ตรวจสอบย้อนหลังไม่ได้  [PP 8 · PP 9]</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="S" targetRef="T1"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T1" targetRef="T2"/>
    <bpmn:sequenceFlow id="F3" sourceRef="T2" targetRef="T3"/>
    <bpmn:sequenceFlow id="F4" sourceRef="T3" targetRef="T4"/>
    <bpmn:sequenceFlow id="F5" sourceRef="T4" targetRef="T5"/>
    <bpmn:sequenceFlow id="F6" sourceRef="T5" targetRef="T6"/>
    <bpmn:sequenceFlow id="F7" sourceRef="T6" targetRef="E"/>
    <bpmn:association id="A1_a" sourceRef="T1" targetRef="A1"/>
    <bpmn:association id="A2_a" sourceRef="T4" targetRef="A2"/>
    <bpmn:association id="A3_a" sourceRef="T6" targetRef="A3"/>
  </bpmn:process>
