<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="D_W1_ToBe" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" targetNamespace="http://sriborisud.local/bpmn" exporter="sriborisud-laundry IS" exporterVersion="1.0">
  <bpmn:collaboration id="Collab_1">
    <bpmn:participant id="P_Cust" name="ลูกค้า"/>
    <bpmn:participant id="P_Main" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="P_W1_ToBe"/>
    <bpmn:messageFlow id="MF_Clothes" name="ส่งมอบเสื้อผ้า" sourceRef="P_Cust" targetRef="Start_1"/>
    <bpmn:messageFlow id="MF_Receipt" name="ใบรับของ + QR ผูก LINE" sourceRef="S_Bill" targetRef="P_Cust"/>
    <bpmn:messageFlow id="MF_Notify" name="แจ้ง LINE ว่ารับผ้าแล้ว" sourceRef="S_Event" targetRef="P_Cust"/>
  </bpmn:collaboration>
  <bpmn:process id="P_W1_ToBe" isExecutable="false">
    <bpmn:laneSet id="LS_1">
      <bpmn:lane id="L_Own" name="เจ้าของร้าน">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_PhoneJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_Rush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>G_RushJ</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Attach</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_Cabinet</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="L_Sys" name="ระบบสารสนเทศ">
        <bpmn:flowNodeRef>S_Due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_LinkPhone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Rush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_Event</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_1" name="ลูกค้านำเสื้อผ้ามาส่ง">
      <bpmn:outgoing>F1</bpmn:outgoing>
      <bpmn:messageEventDefinition id="Start_1_ed"/>
    </bpmn:startEvent>
    <bpmn:userTask id="T_Inspect" name="ตรวจนับและบันทึกรายการเสื้อผ้า">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_Due" name="เสนอวันนัดรับจากประเภทผ้าและคิวงานปัจจุบัน">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Due" name="ยืนยันหรือแก้วันนัดรับ">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_Price" name="คำนวณราคาจากตารางราคา">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Cust" name="ค้นหาหรือเพิ่มข้อมูลลูกค้า">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="G_Phone" name="ลูกค้าให้เบอร์โทรหรือไม่">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_LinkPhone" name="ผูกเบอร์กับบัญชีลูกค้า">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_PhoneJ">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="G_Rush" name="งานด่วนหรือไม่">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Rush" name="ตั้งค่าสถานะงานด่วน">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="G_RushJ">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="S_Bill" name="ออกเลขบิลและสร้างรายการรายชิ้น">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_1"><bpmn:targetRef>DS_DB</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="S_Label" name="พิมพ์ป้ายบาร์โค้ดทุกชิ้น">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DOA_2"><bpmn:targetRef>DO_Label</bpmn:targetRef></bpmn:dataOutputAssociation>
    </bpmn:serviceTask>
    <bpmn:userTask id="T_Attach" name="ติดป้ายบนเสื้อผ้าทุกชิ้น">
      <bpmn:incoming>F16</bpmn:incoming>
      <bpmn:outgoing>F17</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="T_Cabinet" name="นำเสื้อผ้าเข้าตู้รอซัก">
      <bpmn:incoming>F17</bpmn:incoming>
      <bpmn:outgoing>F18</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="S_Event" name="บันทึก status_event = RECEIVED">
      <bpmn:incoming>F18</bpmn:incoming>
      <bpmn:outgoing>F19</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_1" name="ผ้าทุกชิ้นมีตัวตนดิจิทัลแล้ว">
      <bpmn:incoming>F19</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:dataStoreReference id="DS_DB" name="ฐานข้อมูลระบบ"/>
    <bpmn:dataObject id="DO_Label_d"/>
    <bpmn:dataObjectReference id="DO_Label" name="ป้ายบาร์โค้ดรายชิ้น" dataObjectRef="DO_Label_d"/>
    <bpmn:textAnnotation id="A0">
      <bpmn:text>วันนัดรับคำนวณ ณ จุดนี้ · ระบบเสนอ คนยืนยัน · MVP 1 ใช้ค่าตั้งต้นจาก config · MVP 2 คิดจากคิวงานจริง</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A5">
      <bpmn:text>⚠ วันนัดรับถูกคำนวณก่อนรู้สถานะงานด่วน · ต้องถามเจ้าของร้านว่าลูกค้าบอกว่าด่วนตอนไหน ถ้าบอกตั้งแต่ส่งของ ต้องย้าย gateway มาก่อนจุดนี้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A1">
      <bpmn:text>ราคามาจากตารางราคาที่ตั้งค่าได้ · ไม่ขึ้นกับว่าใครออกบิล</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A2">
      <bpmn:text>ลูกค้าที่ไม่ให้เบอร์ยังผูก LINE เองได้ภายหลัง ผ่าน QR บนใบรับของ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A3">
      <bpmn:text>งานด่วนขึ้นในคิวของช่างรีดเอง ไม่ต้องแจ้งด้วยวาจาอีก</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="A4">
      <bpmn:text>ตัวตนของผ้าหนึ่งชิ้นคือบาร์โค้ดในฐานข้อมูล ป้ายหลุดก็พิมพ์ใหม่ได้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="T_Inspect"/>
    <bpmn:sequenceFlow id="F2" sourceRef="T_Inspect" targetRef="S_Due"/>
    <bpmn:sequenceFlow id="F3" sourceRef="S_Due" targetRef="T_Due"/>
