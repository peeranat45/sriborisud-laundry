    <bpmn:sequenceFlow id="F11" name="ด่วน" sourceRef="G_Rush" targetRef="S_Rush"/>
    <bpmn:sequenceFlow id="F12" sourceRef="S_Rush" targetRef="G_RushJ"/>
    <bpmn:sequenceFlow id="F13" name="ปกติ" sourceRef="G_Rush" targetRef="G_RushJ"/>
    <bpmn:sequenceFlow id="F14" sourceRef="G_RushJ" targetRef="S_Bill"/>
    <bpmn:sequenceFlow id="F15" sourceRef="S_Bill" targetRef="S_Label"/>
    <bpmn:sequenceFlow id="F16" sourceRef="S_Label" targetRef="T_Attach"/>
    <bpmn:sequenceFlow id="F17" sourceRef="T_Attach" targetRef="T_Cabinet"/>
    <bpmn:sequenceFlow id="F18" sourceRef="T_Cabinet" targetRef="S_Event"/>
    <bpmn:sequenceFlow id="F19" sourceRef="S_Event" targetRef="End_1"/>
    <bpmn:association id="A0_a" sourceRef="S_Due" targetRef="A0"/>
    <bpmn:association id="A5_a" sourceRef="T_Due" targetRef="A5"/>
    <bpmn:association id="A1_a" sourceRef="S_Price" targetRef="A1"/>
