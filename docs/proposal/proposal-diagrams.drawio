        <mxCell id="bo2-pq" value="แจ้งปัญหา พร้อมรูป&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;เฉพาะเมื่อพบปัญหา&lt;/font&gt;" style="fontFamily=Tahoma;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=light-dark(#FF9580,#FF9580);strokeColor=light-dark(#FF9580,#FF9580);fontColor=light-dark(#201D18,#201D18);fontSize=14;" vertex="1" parent="1"><mxGeometry x="433" y="350.364" width="339" height="46" as="geometry"/></mxCell>
        <mxCell id="bo2-sq" value="พักผ้าชิ้นนี้ไว้&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;หายจากคิวทุกสถานี&lt;/font&gt;" style="fontFamily=Tahoma;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=light-dark(#CCFFCC,#CCFFCC);strokeColor=light-dark(#CCFFCC,#CCFFCC);fontColor=light-dark(#201D18,#201D18);fontSize=14;" vertex="1" parent="1"><mxGeometry x="828" y="350.364" width="339" height="46" as="geometry"/></mxCell>
        <mxCell id="bo2-oq" value="ตัดสินใจ แล้วปลดพัก&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;ระบบแจ้งใน Front Office&lt;/font&gt;" style="fontFamily=Tahoma;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=light-dark(#FF99CC,#FF99CC);strokeColor=light-dark(#FF99CC,#FF99CC);fontColor=light-dark(#201D18,#201D18);fontSize=14;" vertex="1" parent="1"><mxGeometry x="1223" y="350.364" width="339" height="46" as="geometry"/></mxCell>
