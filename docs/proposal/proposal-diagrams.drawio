        <mxCell id="bo-s2" value="&lt;b&gt;2&lt;/b&gt;&amp;nbsp; สแกนป้ายผ้าทีละชิ้น" style="fontFamily=Tahoma;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=light-dark(#FF9580,#FF9580);strokeColor=light-dark(#FF9580,#FF9580);fontColor=light-dark(#201D18,#201D18);fontSize=14;" vertex="1" parent="1"><mxGeometry x="23" y="141.273" width="290" height="46" as="geometry"/></mxCell>
