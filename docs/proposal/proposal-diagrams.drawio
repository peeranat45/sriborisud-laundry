        <mxCell id="bo1-w6" value="&lt;b&gt;6&lt;/b&gt;&amp;nbsp; สแกนป้ายราวตาก&lt;br&gt;&lt;font style=&#x27;font-size:12px&#x27;&gt;สแกนครั้งเดียวต่อหลายชิ้น&lt;/font&gt;" style="fontFamily=Tahoma;html=1;whiteSpace=wrap;rounded=1;arcSize=10;fillColor=light-dark(#FF9580,#FF9580);strokeColor=light-dark(#FF9580,#FF9580);fontColor=light-dark(#201D18,#201D18);fontSize=14;" vertex="1" parent="1"><mxGeometry x="630" y="411.455" width="340" height="46" as="geometry"/></mxCell>
