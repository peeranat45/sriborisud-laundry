<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_Process_shop_asis" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://sriborisud.local/bpmn">
  <bpmn:dataStore id="DS_book_global" name="เล่มบิล (กระดาษ)" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_customer" name="ลูกค้า" />
    <bpmn:participant id="Pool_shop" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="Process_shop_asis" />
    <bpmn:messageFlow id="MF1" name="ส่งมอบเสื้อผ้า" sourceRef="Pool_customer" targetRef="Start_1" />
    <bpmn:messageFlow id="MF2" name="ใบรับของ" sourceRef="T_bill" targetRef="Pool_customer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_shop_asis" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_owner" name="เจ้าของร้าน">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_inspect</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_cust</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_phone</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_phone_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_bill</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_rush</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_tell</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_rush_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_write</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DS_book" name="เล่มบิล (กระดาษ)" dataStoreRef="DS_book_global" />
    <bpmn:dataObject id="DO_receipt_obj" />
    <bpmn:dataObjectReference id="DO_receipt" name="ใบรับของ" dataObjectRef="DO_receipt_obj" />
    <bpmn:dataObject id="DO_tag_obj" />
    <bpmn:dataObjectReference id="DO_tag" name="ป้ายกระดาษเขียนเลขบิล" dataObjectRef="DO_tag_obj" />
    <bpmn:startEvent id="Start_1" name="ลูกค้านำเสื้อผ้ามาส่ง">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="T_inspect" name="ตรวจนับและแยกชนิดเสื้อผ้า">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_due" name="ประเมินวันแล้วเสร็จ">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:dataInputAssociation id="DA1">
        <bpmn:sourceRef>DS_book</bpmn:sourceRef>
      </bpmn:dataInputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_price" name="คำนวณราคา">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_cust" name="รับข้อมูลลูกค้า">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_phone" name="ลูกค้าให้เบอร์โทรหรือไม่">
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_phone" name="จดเบอร์โทรลงในบิล">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_phone_j" name="">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_bill" name="ออกบิล Running Number">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA2">
        <bpmn:targetRef>DS_book</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
      <bpmn:dataOutputAssociation id="DA3">
        <bpmn:targetRef>DO_receipt</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_rush" name="งานด่วนหรือไม่">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:outgoing>F13</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_tell" name="แจ้งช่างรีดด้วยวาจา">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_rush_j" name="">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:incoming>F13</bpmn:incoming>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_write" name="เขียนเลขบิลบนเสื้อผ้าทุกชิ้น">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA4">
        <bpmn:targetRef>DO_tag</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_store" name="นำเสื้อผ้าเข้าตู้รอซัก">
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_1" name="เสื้อผ้าอยู่ในตู้รอซัก">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:textAnnotation id="N_price">
      <bpmn:text>ไม่มีตารางราคาเป็นลายลักษณ์อักษร ราคาขึ้นกับคนออกบิล</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_phone">
      <bpmn:text>ประมาณ 20% ของบิลไม่มีเบอร์ติดต่อ ≈ 4,000 บิลต่อปีที่ตามลูกค้าไม่ได้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_tell">
      <bpmn:text>สื่อสารด้วยวาจา ไม่เหลือร่องรอย ถ้าลืมก็ไม่มีใครรู้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_tag">
      <bpmn:text>ตัวตนของผ้าหนึ่งชิ้นคือหมึกบนกระดาษ ป้ายหลุดแล้วตามไม่ได้</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="T_inspect" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_inspect" targetRef="T_due" />
    <bpmn:sequenceFlow id="F3" sourceRef="T_due" targetRef="T_price" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_price" targetRef="T_cust" />
    <bpmn:sequenceFlow id="F5" sourceRef="T_cust" targetRef="GW_phone" />
    <bpmn:sequenceFlow id="F6" name="ให้เบอร์" sourceRef="GW_phone" targetRef="T_phone" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_phone" targetRef="GW_phone_j" />
    <bpmn:sequenceFlow id="F8" name="ไม่ให้เบอร์" sourceRef="GW_phone" targetRef="GW_phone_j" />
    <bpmn:sequenceFlow id="F9" sourceRef="GW_phone_j" targetRef="T_bill" />
    <bpmn:sequenceFlow id="F10" sourceRef="T_bill" targetRef="GW_rush" />
    <bpmn:sequenceFlow id="F11" name="ด่วน" sourceRef="GW_rush" targetRef="T_tell" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_tell" targetRef="GW_rush_j" />
    <bpmn:sequenceFlow id="F13" name="ปกติ" sourceRef="GW_rush" targetRef="GW_rush_j" />
    <bpmn:sequenceFlow id="F14" sourceRef="GW_rush_j" targetRef="T_write" />
    <bpmn:sequenceFlow id="F15" sourceRef="T_write" targetRef="T_store" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_store" targetRef="End_1" />
    <bpmn:association id="AS1" sourceRef="T_price" targetRef="N_price" />
    <bpmn:association id="AS2" sourceRef="GW_phone" targetRef="N_phone" />
    <bpmn:association id="AS3" sourceRef="T_tell" targetRef="N_tell" />
    <bpmn:association id="AS4" sourceRef="T_write" targetRef="N_tag" />
  </bpmn:process>
