<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions id="Definitions_Process_shop_tobe" xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" targetNamespace="http://sriborisud.local/bpmn">
  <bpmn:dataStore id="DS_db_global" name="ฐานข้อมูล" />
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Pool_customer" name="ลูกค้า" />
    <bpmn:participant id="Pool_shop" name="ร้านศรีบริสุทธิ์ ซักแห้ง" processRef="Process_shop_tobe" />
    <bpmn:messageFlow id="MF1" name="ส่งมอบเสื้อผ้า" sourceRef="Pool_customer" targetRef="Start_1" />
    <bpmn:messageFlow id="MF2" name="ใบรับของ + QR" sourceRef="S_receipt" targetRef="Pool_customer" />
  </bpmn:collaboration>
  <bpmn:process id="Process_shop_tobe" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_owner" name="เจ้าของร้าน">
        <bpmn:flowNodeRef>Start_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_find</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_found</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_new</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>GW_found_j</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_items</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_due</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_save</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_stick</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>T_store</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_system" name="ระบบ">
        <bpmn:flowNodeRef>S_price</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_number</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_label</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>S_receipt</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:dataStoreReference id="DS_db" name="ฐานข้อมูล" dataStoreRef="DS_db_global" />
    <bpmn:dataObject id="DO_label_obj" />
    <bpmn:dataObjectReference id="DO_label" name="ป้ายบาร์โค้ดรายชิ้น" dataObjectRef="DO_label_obj" />
    <bpmn:startEvent id="Start_1" name="ลูกค้านำเสื้อผ้ามาส่ง">
      <bpmn:outgoing>F1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="T_find" name="ค้นหาลูกค้าด้วยเบอร์โทร">
      <bpmn:incoming>F1</bpmn:incoming>
      <bpmn:outgoing>F2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_found" name="พบลูกค้าเดิมหรือไม่">
      <bpmn:incoming>F2</bpmn:incoming>
      <bpmn:outgoing>F3</bpmn:outgoing>
      <bpmn:outgoing>F5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_new" name="สร้างลูกค้าใหม่">
      <bpmn:incoming>F3</bpmn:incoming>
      <bpmn:outgoing>F4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="GW_found_j" name="">
      <bpmn:incoming>F4</bpmn:incoming>
      <bpmn:incoming>F5</bpmn:incoming>
      <bpmn:outgoing>F6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="T_items" name="บันทึกรายการเสื้อผ้ารายชิ้น">
      <bpmn:incoming>F6</bpmn:incoming>
      <bpmn:outgoing>F7</bpmn:outgoing>
      <bpmn:outgoing>F14</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_due" name="เลือกวันนัดรับและงานด่วน">
      <bpmn:incoming>F7</bpmn:incoming>
      <bpmn:incoming>F15</bpmn:incoming>
      <bpmn:outgoing>F8</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_save" name="บันทึกบิล">
      <bpmn:incoming>F8</bpmn:incoming>
      <bpmn:outgoing>F9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_stick" name="ติดป้ายบาร์โค้ดบนเสื้อผ้าทุกชิ้น">
      <bpmn:incoming>F11</bpmn:incoming>
      <bpmn:outgoing>F12</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="T_store" name="นำเสื้อผ้าเข้าตู้รอซัก">
      <bpmn:incoming>F12</bpmn:incoming>
      <bpmn:outgoing>F13</bpmn:outgoing>
      <bpmn:outgoing>F16</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_1" name="เสื้อผ้าพร้อมถูกสแกนทุกสเตจ">
      <bpmn:incoming>F13</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="S_price" name="คำนวณราคาจากตารางราคา">
      <bpmn:incoming>F14</bpmn:incoming>
      <bpmn:outgoing>F15</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="S_number" name="ออกเลขบิลและรหัสรายชิ้น">
      <bpmn:incoming>F9</bpmn:incoming>
      <bpmn:outgoing>F10</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA1">
        <bpmn:targetRef>DS_db</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="S_label" name="สร้างและสั่งพิมพ์ป้ายบาร์โค้ด">
      <bpmn:incoming>F10</bpmn:incoming>
      <bpmn:outgoing>F11</bpmn:outgoing>
      <bpmn:dataOutputAssociation id="DA2">
        <bpmn:targetRef>DO_label</bpmn:targetRef>
      </bpmn:dataOutputAssociation>
    </bpmn:manualTask>
    <bpmn:manualTask id="S_receipt" name="ส่งใบรับของพร้อม QR ผูกบัญชี LINE">
      <bpmn:incoming>F16</bpmn:incoming>
    </bpmn:manualTask>
    <bpmn:textAnnotation id="N_price">
      <bpmn:text>ราคามาจากตารางราคาในระบบ ไม่ขึ้นกับคนออกบิลอีกต่อไป</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="N_qr">
      <bpmn:text>ลูกค้าที่ไม่ให้เบอร์ยังผูกบัญชีเองได้ภายหลังด้วย QR บนใบรับของ</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:sequenceFlow id="F1" sourceRef="Start_1" targetRef="T_find" />
    <bpmn:sequenceFlow id="F2" sourceRef="T_find" targetRef="GW_found" />
    <bpmn:sequenceFlow id="F3" name="ไม่พบ" sourceRef="GW_found" targetRef="T_new" />
    <bpmn:sequenceFlow id="F4" sourceRef="T_new" targetRef="GW_found_j" />
    <bpmn:sequenceFlow id="F5" name="พบ" sourceRef="GW_found" targetRef="GW_found_j" />
    <bpmn:sequenceFlow id="F6" sourceRef="GW_found_j" targetRef="T_items" />
    <bpmn:sequenceFlow id="F7" sourceRef="T_items" targetRef="T_due" />
    <bpmn:sequenceFlow id="F8" sourceRef="T_due" targetRef="T_save" />
    <bpmn:sequenceFlow id="F9" sourceRef="T_save" targetRef="S_number" />
    <bpmn:sequenceFlow id="F10" sourceRef="S_number" targetRef="S_label" />
    <bpmn:sequenceFlow id="F11" sourceRef="S_label" targetRef="T_stick" />
    <bpmn:sequenceFlow id="F12" sourceRef="T_stick" targetRef="T_store" />
    <bpmn:sequenceFlow id="F13" sourceRef="T_store" targetRef="End_1" />
    <bpmn:sequenceFlow id="F14" sourceRef="T_items" targetRef="S_price" />
    <bpmn:sequenceFlow id="F15" sourceRef="S_price" targetRef="T_due" />
    <bpmn:sequenceFlow id="F16" sourceRef="T_store" targetRef="S_receipt" />
    <bpmn:association id="AS1" sourceRef="S_price" targetRef="N_price" />
    <bpmn:association id="AS2" sourceRef="S_receipt" targetRef="N_qr" />
  </bpmn:process>
