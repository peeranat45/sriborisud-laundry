# คัดลอกเป็น .env.local แล้วใส่ค่าจริง · .env.local ถูก gitignore ไว้แล้ว

# ── ฐานข้อมูล · Supabase ───────────────────────────────
# DATABASE_URL  ต้องเป็น "connection pooler" และต้องมี ?pgbouncer=true
#   ถ้าใช้ connection ตรงบน Vercel จะเปิด connection ใหม่ทุก request จน Postgres เต็ม
# DIRECT_URL    เป็น connection ตรง · prisma migrate ใช้ตัวนี้เท่านั้น
# ── พัฒนาในเครื่อง · Postgres ใน Docker (./scripts/dev.sh) ──
# พอร์ต 5433 ไม่ใช่ 5432 เพราะ 5432 มักถูกจองโดยโปรเจกต์อื่นอยู่แล้ว
# ในเครื่องไม่ต้องใส่ ?pgbouncer=true · อันนั้นมีไว้สำหรับ Supabase pooler
DATABASE_URL="postgresql://sriborisud:localdev@localhost:5433/sriborisud"
DIRECT_URL="postgresql://sriborisud:localdev@localhost:5433/sriborisud"

# ── ขึ้น production · Supabase (ใส่ใน Vercel ไม่ใช่ในไฟล์นี้) ──
# DATABASE_URL="postgresql://postgres.xxxx:PASSWORD@...pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres.xxxx:PASSWORD@...pooler.supabase.com:5432/postgres"

# ── LINE · ทั้งสอง channel ต้องอยู่ใน Provider เดียวกัน ──
# ไม่งั้น userId ที่ได้จาก LIFF จะไม่ตรงกับที่ Messaging API ใช้ส่งข้อความ
# แล้วจะ "ผูกสำเร็จแต่ข้อความไม่เคยถึง" โดยไม่มี error ให้เห็น

# จาก LINE Login channel → LIFF → LIFF ID · รูปแบบ 1234567890-abcdefgh
# LIFF app ต้องเปิด scope "openid" ไม่งั้น getIDToken() คืน null
NEXT_PUBLIC_LIFF_ID=

# จาก LINE Login channel → Basic settings → Channel ID · ตัวเลขล้วน
# ใช้ตรวจ ID token ฝั่งเซิร์ฟเวอร์ (ค่า aud ใน token ต้องตรงกับค่านี้)
LINE_LOGIN_CHANNEL_ID=

# จาก Messaging API channel · ใช้ส่งข้อความแจ้งเตือน (ยังไม่ใช้ในขั้นนี้)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── โทเคนบนใบรับของ ────────────────────────────────────
# ใช้เซ็น QR กันคนเดาเลขบิลแล้วผูกบัญชีคนอื่น
# สร้างด้วย   openssl rand -base64 48
# ❗ ห้ามเปลี่ยนหลังพิมพ์ใบรับของไปแล้ว QR เก่าจะใช้ไม่ได้ทั้งหมด
BILL_TOKEN_SECRET=
