# คัดลอกไฟล์นี้เป็น .env.local แล้วใส่ค่าจริง
# .env.local ถูก gitignore ไว้แล้ว ห้าม commit ค่าจริงขึ้น git

# ── S3 · LIFF ───────────────────────────────────────────
# ได้จาก LINE Developers Console → LINE Login channel → LIFF → LIFF ID
# รูปแบบ 1234567890-abcdefgh
# ต้องเปิด scope "openid" ไม่งั้น getIDToken() จะคืนค่า null
NEXT_PUBLIC_LIFF_ID=

# Channel ID ของ LINE Login channel ที่ LIFF app ตัวนี้สังกัดอยู่
# ใช้ตรวจ ID token ฝั่งเซิร์ฟเวอร์ (ค่า aud ใน token ต้องตรงกับค่านี้)
# คนละตัวกับ LIFF ID · เป็นตัวเลขล้วน
LINE_LOGIN_CHANNEL_ID=

# ── โทเคนบนใบรับของ ────────────────────────────────────
# ใช้เซ็น QR บนใบรับของ กันคนเดาเลขบิลแล้วผูกบัญชีคนอื่น
# สร้างด้วย   openssl rand -base64 48
# ห้ามเปลี่ยนหลังพิมพ์ใบรับของไปแล้ว ไม่งั้น QR เก่าใช้ไม่ได้ทั้งหมด
BILL_TOKEN_SECRET=

# ── S7 · ส่งข้อความผ่าน LINE (ยังไม่ใช้ในขั้น POC) ──────
# ได้จาก channel ประเภท Messaging API — คนละ channel กับ LIFF
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# ── S5 · PromptPay ─────────────────────────────────────
# หมายเลขพร้อมเพย์ของร้าน ใช้ทดสอบการสร้าง QR
NEXT_PUBLIC_PROMPTPAY_ID=
