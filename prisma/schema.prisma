// ═══════════════════════════════════════════════════════════════
//  ศรีบริสุทธิ์ ซักแห้ง · schema
//  ---------------------------------------------------------------
//  ขั้นนี้ migrate ส่วนของ "ลงทะเบียนลูกค้า" และ "รับผ้าเข้า"
//  ตารางของ tracking / payroll / payment จะเพิ่มทีละ feature
//  ภาพรวมปลายทางทั้งระบบอยู่ใน docs/ERD-TARGET.md
//
//  การตัดสินใจที่ล็อกไว้แล้ว  (ดู docs/ADR)
//    D1  บัญชี LINE อยู่ตารางแยก · ลูกค้า 1 คนผูกได้หลายบัญชี
//    D2  เบอร์โทร unique · "ลูกค้า" คือจุดติดต่อ ไม่ใช่ตัวบุคคล
//    D3  กุญแจคือ id ภายใน ไม่ใช่เบอร์โทร
//    D4  บัญชี LINE 1 บัญชีผูกได้หลายลูกค้า (คนรับผ้าแทนทั้งบ้าน)
// ═══════════════════════════════════════════════════════════════

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")       // pooler · ?pgbouncer=true
  directUrl = env("DIRECT_URL")         // direct · ใช้ตอน migrate เท่านั้น
}

// ───────────────────────────────────────────────────────────────
//  ลูกค้า = จุดติดต่อ
//
//  phone เป็น unique แต่ nullable
//  Postgres ถือว่า NULL แต่ละค่าไม่เท่ากัน ลูกค้าที่ไม่มีเบอร์จึงมีได้ไม่จำกัด
//  ซึ่งสำคัญมาก เพราะประมาณ 20% ของบิลไม่มีเบอร์
//
//  ⚠️ @unique ที่ Prisma สร้างเป็น index ธรรมดา ซึ่งทำให้ลูกค้าที่ถูก soft delete
//     ยังจองเบอร์นั้นไว้ตลอดไป · ต้องแก้ migration เป็น partial unique index
//     ดูวิธีใน prisma/migrations/README.md
// ───────────────────────────────────────────────────────────────
model Customer {
  id        String    @id @default(cuid())
  name      String
  phone     String?   @unique           // เก็บรูปแบบปกติแล้วเท่านั้น · 0XXXXXXXXX
  note      String?                      // "ร้านตัดผมหน้าปากซอย" ช่วยแยกคนชื่อซ้ำ
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  lineAccounts CustomerLineAccount[]
  bills        Bill[]
  mergedFrom   CustomerMerge[]       @relation("MergeTarget")
  mergedInto   CustomerMerge[]       @relation("MergeSource")

  @@index([name])
  @@index([deletedAt])
}

// ───────────────────────────────────────────────────────────────
//  D1 + D4 · ความสัมพันธ์แบบหลายต่อหลาย
//
//  สามีภรรยาผูก LINE คนละบัญชีเข้ากับลูกค้ารายเดียวกันได้   (D1)
//  และคนหนึ่งที่รับผ้าแทนทั้งบ้านผูกบัญชีเดียวกับลูกค้าหลายรายได้ (D4)
//
//  unlinkedAt ไม่ใช่การลบแถว เพราะต้องรู้ย้อนหลังว่าเคยผูกเมื่อไร ยกเลิกเมื่อไร
// ───────────────────────────────────────────────────────────────
model CustomerLineAccount {
  id         String    @id @default(cuid())
  customerId String
  lineUserId String
  linkedAt   DateTime  @default(now())
  unlinkedAt DateTime?
  /// ผูกผ่านบิลใบไหน · ใช้ตรวจย้อนหลังเวลามีข้อพิพาท
  viaBillNo  String?

  customer Customer @relation(fields: [customerId], references: [id])

  // BR-C4 · ผูกซ้ำที่เคยยกเลิก = เปิดแถวเดิมกลับมา ไม่สร้างแถวใหม่
  @@unique([customerId, lineUserId])
  @@index([lineUserId, unlinkedAt])
}

// ───────────────────────────────────────────────────────────────
//  บิล · ขั้นนี้เอาเท่าที่การผูกบัญชีต้องใช้
//  รายการรายชิ้น ราคา ประเภทผ้า จะมาพร้อม feature รับผ้าเข้า
// ───────────────────────────────────────────────────────────────
//  totalSatang เป็นค่าที่คำนวณได้จาก Piece แต่ยังเก็บซ้ำไว้โดยตั้งใจ
//  เพราะยอดบนใบรับของต้องเป็นยอดวันที่รับเข้า · ถ้าภายหลังมีการแก้ราคา
//  ยอดเดิมต้องไม่เปลี่ยนตาม
model Bill {
  id          String   @id @default(cuid())
  billNo      String                      // "04832" · เริ่มนับใหม่ทุก 1 ม.ค.
  year        Int
  customerId  String
  dueDate     DateTime
  totalSatang Int                         // ❗ สตางค์ · ห้ามใช้ Float กับเงิน
  createdAt   DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id])
  pieces   Piece[]

  @@unique([billNo, year])
  @@index([customerId])
}

// ───────────────────────────────────────────────────────────────
//  ประเภทผ้า
//
//  ⚠️ defaultPriceSatang เป็น null ได้ และตอนนี้เป็น null ทั้งหมด
//     เพราะยังไม่ได้ถามราคาจริงจากร้าน (คำถาม B1)
//     ตั้งราคามั่วไว้แล้วมันจะกลายเป็น "ราคาที่ระบบบอก" ซึ่งอันตรายกว่าว่าง
//     ตอนนี้พนักงานกรอกราคาเองทุกชิ้น · พอได้คำตอบ B1 แล้วค่อยเติม
//
//  ตารางนี้ยังไม่มีช่วงเวลาของราคา (PriceRate ใน docs/ERD-TARGET.md)
//  จะเพิ่มตอนทำ feature ขึ้นราคา · ตอนนี้ราคาถูกล็อกไว้ที่ Piece แล้ว
// ───────────────────────────────────────────────────────────────
model ClothesType {
  id                 String  @id @default(cuid())
  name               String                   // "เสื้อเชิ้ต"
  service            String                   // "ซักแห้ง" · "ซักรีด"
  defaultPriceSatang Int?                     // null = ต้องกรอกเอง
  sortOrder          Int     @default(0)      // ลำดับในหน้าจอ · ของที่รับบ่อยอยู่บน
  active             Boolean @default(true)   // เลิกรับแล้วให้ปิด ไม่ใช่ลบ

  pieces Piece[]

  @@unique([name, service])
  @@index([active, sortOrder])
}

// ───────────────────────────────────────────────────────────────
//  ผ้าแต่ละชิ้น
//
//  ทำไมต้องแยกเป็นรายชิ้น ไม่เก็บเป็น "เสื้อเชิ้ต 3 ตัว" ในบรรทัดเดียว
//    · รับคืนบางส่วนได้  (ลูกค้ามารับ 2 ตัว เหลือ 1 ตัว)
//    · ติดตามสเตจรายชิ้นได้ (ตัวหนึ่งรีดเสร็จ อีกตัวยังซัก)
//    · คิดค่าแรงรายชิ้นได้
//  ราคาต่อชิ้นจึงอยู่ที่นี่ และถูกล็อกไว้ ณ วันรับเข้า
//
//  pieceNo คือ "04832-01" · เลขบิล + ลำดับในบิล
//  ยังไม่มี barcode ในขั้นนี้ · จะมาพร้อม feature สแกนของพนักงาน
// ───────────────────────────────────────────────────────────────
model Piece {
  id            String   @id @default(cuid())
  billId        String
  clothesTypeId String
  pieceNo       String                    // "04832-01"
  priceSatang   Int                       // ล็อกราคา ณ วันรับเข้า
  note          String?                   // "คราบที่ปลายแขนขวา"
  createdAt     DateTime @default(now())

  // ลบบิลทิ้ง = ชิ้นในบิลหายไปด้วย · ชิ้นที่ไม่มีบิลไม่มีความหมาย
  bill        Bill        @relation(fields: [billId], references: [id], onDelete: Cascade)
  // แต่ประเภทผ้าลบไม่ได้ถ้ายังมีชิ้นอ้างอยู่ · ใช้ active = false แทน
  clothesType ClothesType @relation(fields: [clothesTypeId], references: [id])

  @@unique([billId, pieceNo])
  @@index([clothesTypeId])
}

// ───────────────────────────────────────────────────────────────
//  การรวมลูกค้าซ้ำ
//  ถึงจะบังคับ unique ที่เบอร์แล้ว ลูกค้าซ้ำก็ยังเกิดได้
//    · สองรายที่ไม่มีเบอร์ทั้งคู่
//    · รายที่ไม่มีเบอร์ แล้วภายหลังให้เบอร์ที่ตรงกับอีกราย
//  เก็บประวัติการรวมไว้ เพราะการรวมผิดต้องตามแก้ได้
// ───────────────────────────────────────────────────────────────
model CustomerMerge {
  id         String   @id @default(cuid())
  sourceId   String                       // รายที่ถูกยุบ
  targetId   String                       // รายที่เหลืออยู่
  reason     String
  mergedAt   DateTime @default(now())
  mergedBy   String                       // staff id · ยังไม่มีตาราง staff

  source Customer @relation("MergeSource", fields: [sourceId], references: [id])
  target Customer @relation("MergeTarget", fields: [targetId], references: [id])

  @@index([targetId])
}
